+static void DrawDevConsole()
+{
+  const bool open = BigWillyConsole::IsOpen();
+
+  // Animate the panel sliding down from the top of the screen.
+  static float s_slide = 0.0f;
+  const float dt = ImGui::GetIO().DeltaTime;
+  constexpr float SLIDE_SPEED = 10.0f;
+  s_slide += (open ? 1.0f : -1.0f) * SLIDE_SPEED * dt;
+  s_slide = std::clamp(s_slide, 0.0f, 1.0f);
+
+  if (s_slide <= 0.0f)
+    return;
+
+  // Smooth-step easing.
+  const float t = s_slide * s_slide * (3.0f - 2.0f * s_slide);
+
+  const ImGuiIO& io = ImGui::GetIO();
+  const float console_h = io.DisplaySize.y * 0.42f;
+  // Panel slides in from above: y goes from -console_h (hidden) to 0 (visible).
+  const float y_pos = (t - 1.0f) * console_h;
+
+  ImGui::SetNextWindowPos(ImVec2(0.0f, y_pos));
+  ImGui::SetNextWindowSize(ImVec2(io.DisplaySize.x, console_h));
+  ImGui::SetNextWindowBgAlpha(0.88f);
+  constexpr ImGuiWindowFlags kFlags =
+      ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize |
+      ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings |
+      ImGuiWindowFlags_NoBringToFrontOnFocus | ImGuiWindowFlags_NoScrollbar |
+      ImGuiWindowFlags_NoScrollWithMouse;
+
+  if (!ImGui::Begin("##bw_console", nullptr, kFlags))
+  {
+    ImGui::End();
+    return;
+  }
+
+  // Header row.
+  ImGui::TextColored(ImVec4(0.35f, 1.0f, 0.45f, 1.0f), "Furon Dev Console");
+  ImGui::SameLine();
+  ImGui::TextDisabled("  ` to close | Esc to close | Enter to run");
+  ImGui::Separator();
+
+  // Scrollable log area — leave room for the input line at the bottom.
+  const float footer_h = ImGui::GetFrameHeightWithSpacing() + 6.0f;
+  ImGui::BeginChild("##bw_log", ImVec2(0.0f, -footer_h), false,
+                    ImGuiWindowFlags_HorizontalScrollbar);
+
+  bool scroll_now = false;
+  {
+    std::lock_guard<std::mutex> lock(BigWillyConsole::g_mutex);
+    for (const auto& line : BigWillyConsole::g_log)
+    {
+      // Colour-code by prefix.
+      if (line.size() >= 2 && line[0] == '>' && line[1] == ' ')
+        ImGui::TextColored(ImVec4(1.0f, 1.0f, 0.35f, 1.0f), "%s", line.c_str());
+      else if (line.size() >= 5 && line.rfind("[ERR]", 0) == 0)
+        ImGui::TextColored(ImVec4(1.0f, 0.4f, 0.4f, 1.0f), "%s", line.c_str());
+      else
+        ImGui::TextUnformatted(line.c_str());
+    }
+    scroll_now = BigWillyConsole::g_scroll_to_bottom;
+    BigWillyConsole::g_scroll_to_bottom = false;
+  }
+  if (scroll_now)
+    ImGui::SetScrollHereY(1.0f);
+
+  ImGui::EndChild();
+
+  // Input line — rendered as plain text with a static cursor character.
+  ImGui::Separator();
+  const std::string& input = BigWillyConsole::GetInput();
+  ImGui::Text("> %s_", input.c_str());
+
+  ImGui::End();
+}
